# Copiar a .env y rellenar (Dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
# Alternativa legacy si tu proyecto aún usa la anon key:
# VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Herramientas de desarrollo
# Activas en dev por defecto. Poner "false" para desactivarlas
VITE_DEV_TOOLS=

# URL pública del sitio, sin "/" final. Necesaria para la vista previa del link
# (og:image debe ser absoluta en WhatsApp/Facebook).
VITE_SITE_URL=https://tu-dominio.com

# Versión del formulario. "b" = participantes de otras universidades: sin campo
# Universidad (se guarda "Otra"), carrera con opción "Otra" y bienvenida sin
# mencionar la carrera del equipo. Vacío = versión A. Es por build: un deploy por versión.
VITE_VARIANT=
