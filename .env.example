# Copy to .env
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
# Legacy alternative if your project still uses the anon key:
# VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Dev tools: on by default in dev, "false" turns them off.
VITE_DEV_TOOLS=

# Public URL without trailing "/" (og:image must be absolute for link previews).
VITE_SITE_URL=https://tu-dominio.com

# Form version: "b" = other universities, empty = A. One deploy per version.
VITE_VARIANT=
